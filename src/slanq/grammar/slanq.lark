// ---------------------------------------------------------------------------
// Grammar of the Slanq language (initial version)
//
// Note: the grammar is deliberately more permissive than the semantics of the
// language. For example it accepts the "+" operator syntactically, even though
// it does not exist for quantum operands in Slanq -- such cases are rejected by
// semantic analysis (type checking) so that we can report a meaningful error
// instead of a bare "syntax error".
// ---------------------------------------------------------------------------

start: statement*

?statement: declaration
          | process_def
          | if_stmt
          | rt_if_stmt
          | qif_stmt
          | for_stmt
          | rt_while_stmt
          | simple_statement ";"

?simple_statement: assignment
                 | compound_assignment
                 | break_stmt
                 | continue_stmt
                 | call_expr -> expr_statement

break_stmt:    "break"
continue_stmt: "continue"

// --- Declarations ----------------------------------------------------------

?declaration: qint_decl
            | qbool_decl
            | rt_int_decl
            | rt_bool_decl
            | classical_decl
            | param_array_decl
            | param_decl

qint_decl:        "qint" "<" INT ">" NAME "=" q_initializer ";"
// A real-time classical variable: it lives on the processor beside the QPU,
// where bits are scarce, so the width is written out. Empty angle brackets
// take it from the initializer.
rt_int_decl:      "rt" "int" "<" [INT] ">" NAME "=" expr ";"
rt_bool_decl:     "rt" "bool" NAME "=" expr ";"
qbool_decl:       "qbool" NAME "=" q_initializer ";"
classical_decl:   CTYPE NAME "=" expr ";"
param_decl:       "param" CTYPE NAME ";"
param_array_decl: "param" CTYPE NAME "[" INT "]" ";"

?q_initializer: prob_list
              | amplitude_list
              | expr

// An empty list means equal superposition; otherwise a probability list.
prob_list: "[" [NUMBER ("," NUMBER)*] "]"

// An empty list means equal superposition, same as prob_list. Otherwise each
// element is an arbitrary compile-time (possibly complex) amplitude expression.
amplitude_list: "{" [expr ("," expr)*] "}"

// --- Assignment ------------------------------------------------------------

assignment:          lvalue "=" expr
compound_assignment: lvalue AUGOP expr

?lvalue: NAME            -> var
       | NAME "[" expr "]" -> index

AUGOP: "+=" | "-=" | "*=" | "/="

// --- Control structures ----------------------------------------------------

if_stmt:    "if" "(" expr ")" block ("else" else_branch)?
rt_if_stmt: "rt" "if" "(" expr ")" block ("else" rt_else_branch)?
qif_stmt:   "qif" "(" expr ")" block
rt_while_stmt: "rt" "while" "(" expr ")" block

// `else if` is an else branch holding one if, the same shape Python's own ast
// module uses.
?else_branch: block | if_stmt
?rt_else_branch: block | rt_if_stmt

// The iterable is an ordinary expression so that an unsupported one can be
// rejected with a meaningful message; only `range(...)` is accepted today.
for_stmt:  "for" "(" loop_var "in" expr ")" block
loop_var:  CTYPE NAME

block: "{" statement* "}"

// --- Procedures ------------------------------------------------------------

process_def: "process" NAME "(" [param_list] ")" block
param_list:  proc_param ("," proc_param)*
proc_param:  TYPE NAME

// --- Expressions (increasing precedence) -----------------------------------

?expr: or_expr

?or_expr: and_expr
        | or_expr "||" and_expr -> logical_or

?and_expr: comparison
         | and_expr "&&" comparison -> logical_and

// Non-associative: both operands are one level tighter, so `a < b < c` is a
// syntax error.
?comparison: bitor_expr
           | bitor_expr "==" bitor_expr -> eq
           | bitor_expr "!=" bitor_expr -> ne
           | bitor_expr "<=" bitor_expr -> le
           | bitor_expr ">=" bitor_expr -> ge
           | bitor_expr "<"  bitor_expr -> lt
           | bitor_expr ">"  bitor_expr -> gt

?bitor_expr: bitxor_expr
           | bitor_expr "|" bitxor_expr -> bit_or

?bitxor_expr: bitand_expr
            | bitxor_expr "^" bitand_expr -> bit_xor

?bitand_expr: sum
            | bitand_expr "&" sum -> bit_and

?sum: product
    | sum "+" product -> add
    | sum "-" product -> sub

// Division always yields a float, as in Python; `floor()` converts back to an
// integer. `//` cannot denote integer division because it starts a comment.
?product: unary
        | product "*" unary -> mul
        | product "/" unary -> div
        | product "%" unary -> mod

// `!` binds tightly. Python's `not` is looser, so the code generator parenthesises it.
?unary: power
      | "-" unary -> neg
      | "~" unary -> bit_not
      | "!" unary -> logical_not

?power: atom
      | atom "**" unary -> pow

?atom: NUMBER            -> number
     | IMAGINARY         -> imaginary
     | BOOL              -> boolean
     | call_expr
     | NAME "[" expr "]" -> index
     | NAME              -> var
     | "(" expr ")"

call_expr: NAME "(" [arg_list] ")"
arg_list:  expr ("," expr)*

// --- Terminals -------------------------------------------------------------

CTYPE: "int" | "float" | "bool" | "complex"
TYPE:  "qint" | "qbool" | "int" | "float" | "bool"
BOOL:  "true" | "false"

// `[^\W\d]` is a word character that is not a digit, i.e. any letter or
// underscore, Unicode included. Analysis narrows this to the names Python
// keeps unchanged, so every name reaches the generated file as itself.
NAME:      /[^\W\d]\w*/
NUMBER:    /\d+(\.\d+)?/
IMAGINARY: /\d+(\.\d+)?i/
INT:       /\d+/

COMMENT: "//" /[^\n]*/

%ignore COMMENT
%ignore /\s+/
